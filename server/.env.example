# MongoDB connection string. Use a local database or your own secret-managed URI.
# Never put credentials in this file or commit a real URI.
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING

# Required for /api/v1 authentication. Generate a random value of at least 32
# characters and keep it out of source control (for example, with `openssl rand -base64 48`).
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

# Optional: defaults to 5000 when omitted.
PORT=5001

# Comma-separated browser origins permitted to call the API. Local Vite and
# GitHub Codespaces port-preview origins are supported by default. Add the
# deployed application's exact origin before exposing the service publicly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://jubilant-space-eureka-v6gjwqv9prwf75g-5173.app.github.dev

# Optional override for the official CNEOS Scout endpoint. It must remain the
# allowlisted HTTPS https://ssd-api.jpl.nasa.gov/scout.api URI.
# CNEOS_SCOUT_URI=https://ssd-api.jpl.nasa.gov/scout.api

# NASA DONKI CME API endpoint.
# Default replacement: https://ccmc.gsfc.nasa.gov/DONKI-API/get/
# Legacy endpoint: https://kauai.ccmc.gsfc.nasa.gov/DONKI/WS/get/
DONKI_API_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get/

# OrbitForge Server Environment Configuration
AI_CREDENTIAL_SECRET=01234567890123456789012345678901

# AI Provider Configuration
# Set either OPENAI_API_KEY or GEMINI_API_KEY depending on which provider you use.
# OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key

# Role-specific model configurations
SCIENTIFIC_EXPLAINER_PROVIDER=openai
SCIENTIFIC_EXPLAINER_MODEL=gpt-4o-mini

RESEARCH_ASSISTANT_PROVIDER=openai
RESEARCH_ASSISTANT_MODEL=gpt-4o-mini

MISSION_ANALYST_PROVIDER=openai
MISSION_ANALYST_MODEL=gpt-4o-mini
